// Vector math for cosine similarity, written on velt/simd's 128-bit f32x4 lanes.
//
// Vectors in an index are stored flat (row after row) in one f32[], so every
// function takes the array plus the offset where the row starts.
import { f32x4 } from "velt/simd";

/// Dot product of `dim` floats of `a` from `aAt` and of `b` from `bAt`.
/// Sixteen floats per step in four independent accumulators (hides FMA latency),
/// then a scalar tail for dims that are not a multiple of 16.
export function dot(a: f32[], aAt: usize, b: f32[], bAt: usize, dim: usize): f32 {
  let s0 = f32x4.splat(0);
  let s1 = f32x4.splat(0);
  let s2 = f32x4.splat(0);
  let s3 = f32x4.splat(0);
  let i: usize = 0;
  // `fits` on the last vector of the step lets the compiler drop the loads' own checks.
  while (i + 16 <= dim && f32x4.fits(a, aAt + i + 12) && f32x4.fits(b, bAt + i + 12)) {
    s0 = f32x4.load(a, aAt + i).mulAddFast(f32x4.load(b, bAt + i), s0);
    s1 = f32x4.load(a, aAt + i + 4).mulAddFast(f32x4.load(b, bAt + i + 4), s1);
    s2 = f32x4.load(a, aAt + i + 8).mulAddFast(f32x4.load(b, bAt + i + 8), s2);
    s3 = f32x4.load(a, aAt + i + 12).mulAddFast(f32x4.load(b, bAt + i + 12), s3);
    i += 16;
  }
  while (i + 4 <= dim) {
    s0 = f32x4.load(a, aAt + i).mulAddFast(f32x4.load(b, bAt + i), s0);
    i += 4;
  }
  let s = s0.add(s1).add(s2.add(s3)).sum();
  while (i < dim) {
    s += a[aAt + i] * b[bAt + i];
    i++;
  }
  return s;
}

/// The same dot product, one float at a time: the reference the SIMD version is checked against.
export function dotScalar(a: f32[], aAt: usize, b: f32[], bAt: usize, dim: usize): f32 {
  let s: f32 = 0;
  for (let i: usize = 0; i < dim; i++) {
    s += a[aAt + i] * b[bAt + i];
  }
  return s;
}

/// Euclidean length of a whole vector.
export function norm(v: f32[]): f32 {
  return Math.sqrt(dot(v, 0, v, 0, v.length as usize)) as f32;
}

/// A unit-length copy of `v` (a zero vector stays zero).
export function normalized(v: f32[]): f32[] {
  const n = norm(v);
  const out: f32[] = [];
  const inv: f32 = n > 0 ? 1 / n : 0;
  for (let i = 0; i < v.length; i++) {
    out.push(v[i] * inv);
  }
  return out;
}

/// Cosine similarity of two vectors of the same length, in [-1, 1] (0 if either is zero).
export function cosine(a: f32[], b: f32[]): f32 {
  const dim = a.length as usize;
  const na = norm(a);
  const nb = norm(b);
  if (na == 0 || nb == 0) {
    return 0;
  }
  return dot(a, 0, b, 0, dim) / (na * nb);
}
