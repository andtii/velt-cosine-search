// The k best (row, score) pairs seen so far, as a bounded min-heap: the root is the
// worst kept score, so a candidate costs one comparison unless it gets in.

export type Hit = { row: i64; score: f32 };

export class TopK {
  k: i64;
  rows: i64[] = [];
  scores: f32[] = [];

  constructor(k: i64) {
    this.k = k;
  }

  /// The score a candidate must beat to get in (-Infinity until the heap is full).
  floor(): f32 {
    return this.rows.length < this.k ? (-Infinity as f32) : this.scores[0];
  }

  push(row: i64, score: f32) {
    if (this.rows.length < this.k) {
      this.rows.push(row);
      this.scores.push(score);
      this.up(this.rows.length - 1);
    } else if (score > this.scores[0]) {
      this.rows[0] = row;
      this.scores[0] = score;
      this.down(0);
    }
  }

  /// The kept hits, best first.
  sorted(): Hit[] {
    const out: Hit[] = [];
    for (let i = 0; i < this.rows.length; i++) {
      out.push({ row: this.rows[i], score: this.scores[i] });
    }
    out.sort((a, b) => (b.score - a.score) || (a.row - b.row) as number);
    return out;
  }

  private swap(i: number, j: number) {
    const r = this.rows[i];
    this.rows[i] = this.rows[j];
    this.rows[j] = r;
    const s = this.scores[i];
    this.scores[i] = this.scores[j];
    this.scores[j] = s;
  }

  private up(at: number) {
    let i = at;
    while (i > 0) {
      const p = Math.floor((i - 1) / 2);
      if (this.scores[i] >= this.scores[p]) {
        return;
      }
      this.swap(i, p);
      i = p;
    }
  }

  private down(at: number) {
    let i = at;
    const n = this.rows.length;
    while (true) {
      const l = 2 * i + 1;
      const r = l + 1;
      let m = i;
      if (l < n && this.scores[l] < this.scores[m]) {
        m = l;
      }
      if (r < n && this.scores[r] < this.scores[m]) {
        m = r;
      }
      if (m == i) {
        return;
      }
      this.swap(i, m);
      i = m;
    }
  }
}
